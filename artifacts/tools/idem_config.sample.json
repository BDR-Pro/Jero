  "op": {
    "method": "POST",
    "path": "/REPLACE/private/create-withdrawal",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer REPLACE_OWN_TOKEN"
    },
    "body": "{\"amount\":\"0.0001\",\"currency\":\"USDT\",\"address\":\"REPLACE_OWN_ADDRESS\",\"client_wid\":\"REPLACE_SAME_KEY_EACH_TIME\"}"
  }
